{
  "name": "keymaker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4349 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4349 --strictPort",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint src tests",
    "verify:math": "node scripts/verify-math.mjs",
    "build:portfolio": "tsc -b && vite build --base=/keymaker/ --outDir dist-portfolio && node scripts/static-routes.mjs dist-portfolio",
    "verify": "npm test && npm run verify:math && npm run lint && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
